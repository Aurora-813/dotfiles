-- Auto-start config
-- if you dont use UWSM add your auto start programs here, otherwise use XDG autostart https://wiki.archlinux.org/title/XDG_Autostart

hl.on("hyprland.start", function ()
    hl.exec_cmd("dbus-update-activation-environment --systemd --all")
    hl.exec_cmd("xhost +SI:localuser:root")
    hl.exec_cmd("pgrep -x hyprpaper >/dev/null || hyprpaper")
end)

-- Start Caelestia Shell on Hyprland startup
hl.on("hyprland.start", function()
    hl.exec_cmd("caelestia shell -d")
end)

-- Start Polkit authentication agent
hl.on("hyprland.start", function()
    hl.exec_cmd("pgrep -x hyprpolkitagent >/dev/null || /usr/lib/hyprpolkitagent/hyprpolkitagent")
end)

-- Keep Caelestia idle actions inhibited on startup

hl.on("hyprland.start", function()

    hl.exec_cmd("~/.local/bin/enable-caelestia-idle-inhibitor.fish")

end)
